# Aurey - placeholders only. Do not commit real secrets.

# 1Claw (bootstrap key is read from whichever env var name you set in AUREY_ONECLAW_API_KEY_SECRET_SOURCE).
AUREY_ONECLAW_BOOTSTRAP_API_KEY=

# Optional overrides (defaults shown in src/aurey/settings/__init__.py).
# AUREY_ONECLAW_BASE_URL=https://api.1claw.xyz
# AUREY_ONECLAW_VAULT_ID=
# Name of the env var that holds the bootstrap API key (defaults to AUREY_ONECLAW_BOOTSTRAP_API_KEY).
# AUREY_ONECLAW_API_KEY_SECRET_SOURCE=AUREY_ONECLAW_BOOTSTRAP_API_KEY
# Hosted agent flow (optional).
# AUREY_ONECLAW_AGENT_ID=

# Path-style secret references resolved via SecretStore / 1Claw (not local file paths).
# AUREY_ETHEREUM_RPC_SECRET_PATH=
# AUREY_BASE_RPC_SECRET_PATH=
# AUREY_ALCHEMY_API_SECRET_PATH=
# AUREY_LIFI_API_SECRET_PATH=
# AUREY_WALLET_SIGNING_KEY_SECRET_PATH=
