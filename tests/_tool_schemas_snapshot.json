{
  "alchemy_get_portfolio_tokens": {
    "description": "Portfolio token holdings for a wallet.",
    "properties": {
      "chain": {
        "minLength": 1,
        "title": "Chain",
        "type": "string"
      },
      "wallet_address": {
        "minLength": 1,
        "title": "Wallet Address",
        "type": "string"
      }
    },
    "required": [
      "chain",
      "wallet_address"
    ],
    "title": "AlchemyPortfolioArgs",
    "type": "object"
  },
  "alchemy_get_token_prices": {
    "description": "Token prices quoted by contract address.",
    "properties": {
      "chain": {
        "minLength": 1,
        "title": "Chain",
        "type": "string"
      },
      "token_addresses": {
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "title": "Token Addresses",
        "type": "array"
      },
      "wallet_address": {
        "minLength": 1,
        "title": "Wallet Address",
        "type": "string"
      }
    },
    "required": [
      "chain",
      "wallet_address",
      "token_addresses"
    ],
    "title": "AlchemyTokenPricesArgs",
    "type": "object"
  },
  "alchemy_get_transfer_history": {
