        "minLength": 1,
        "title": "Chain",
        "type": "string"
      },
      "wallet_address": {
        "minLength": 1,
        "title": "Wallet Address",
        "type": "string"
      }
    },
    "required": [
      "chain",
      "wallet_address"
    ],
    "title": "AlchemyTransferHistoryArgs",
    "type": "object"
  },
  "evm_get_erc20_balance": {
    "description": "ERC-20 balance read (Mercury-parity stub until full token address wiring).",
    "properties": {
      "chain": {
        "minLength": 1,
        "title": "Chain",
        "type": "string"
      },
      "token_address": {
        "minLength": 1,
        "title": "Token Address",
        "type": "string"
      },
      "wallet_address": {
        "minLength": 1,
        "title": "Wallet Address",
        "type": "string"
      }
    },
    "required": [
      "chain",
