  "evm_get_native_balance": {
    "description": "Native gas-token balance via JSON-RPC (chain + wallet).",
    "properties": {
      "chain": {
        "minLength": 1,
        "title": "Chain",
        "type": "string"
      },
      "wallet_address": {
        "minLength": 1,
        "title": "Wallet Address",
        "type": "string"
      }
    },
    "required": [
      "chain",
      "wallet_address"
    ],
    "title": "EvmGetNativeBalanceArgs",
    "type": "object"
  },
  "evm_resolve_ens": {
    "description": "Resolve an ENS name to an Ethereum checksum-normalized hex address.",
    "properties": {
      "chain": {
        "default": "ethereum",
        "description": "Must be 'ethereum'. ENS forward resolution is only defined on L1 mainnet.",
        "minLength": 1,
        "title": "Chain",
        "type": "string"
      },
      "name": {
        "description": "ENS name such as nick.eth (trimmed and lower-cased by the tool).",
        "minLength": 1,
        "title": "Name",
        "type": "string"
      }
    },
    "required": [
      "name"
    ],
    "title": "EvmResolveEnsArgs",
    "type": "object"
  },
  "request_user_input": {
    "$defs": {
      "UserQuestion": {
        "description": "Single follow-up question for the user or host UI.",
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Id"
          },
          "prompt": {
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          }
        },
        "required": [
          "prompt"
        ],
        "title": "UserQuestion",
        "type": "object"
      }
    },
    "properties": {
      "questions": {
        "items": {
          "$ref": "#/$defs/UserQuestion"
        },
        "minItems": 1,
        "title": "Questions",
        "type": "array"
      }
    },
    "required": [
      "questions"
    ],
    "title": "RequestUserInputArgs",
    "type": "object"
  },
  "resolve_known_address": {
    "description": "Resolve a bundled ticker (e.g. USDC, WETH) to a contract address without RPC.",
    "properties": {
      "chain": {
        "minLength": 1,
        "title": "Chain",
        "type": "string"
      },
      "known_ticker": {
        "description": "Ticker key, e.g. usdc, weth.",
        "minLength": 1,
        "title": "Known Ticker",
        "type": "string"
      }
    },
    "required": [
      "chain",
      "known_ticker"
    ],
    "title": "ResolveKnownAddressArgs",
    "type": "object"
  },
  "swap_prepare": {
    "properties": {
      "from_address": {
        "minLength": 1,
        "title": "From Address",
        "type": "string"
      },
      "from_amount_wei": {
        "minLength": 1,
        "pattern": "^[0-9]+$",
        "title": "From Amount Wei",
        "type": "string"
      },
      "from_asset": {
        "description": "Token contract (0x\u2026) or symbol as accepted by LiFi ``fromToken``.",
        "minLength": 1,
        "title": "From Asset",
        "type": "string"
      },
      "from_chain": {
        "minLength": 1,
        "title": "From Chain",
        "type": "string"
      },
      "order": {
        "anyOf": [
          {
            "enum": [
              "FASTEST",
              "CHEAPEST"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "LiFi route preference; omit for LiFi default sorting.",
        "title": "Order"
      },
      "slippage": {
        "anyOf": [
          {
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Max slippage as decimal (e.g. 0.005 = 0.5%%). Omit for LiFi default.",
        "title": "Slippage"
      },
      "to_address": {
        "minLength": 1,
        "title": "To Address",
        "type": "string"
      },
      "to_asset": {
        "description": "Token contract (0x\u2026) or symbol as accepted by LiFi ``toToken``.",
        "minLength": 1,
        "title": "To Asset",
        "type": "string"
      },
      "to_chain": {
        "minLength": 1,
        "title": "To Chain",
        "type": "string"
      }
    },
    "required": [
      "from_chain",
      "to_chain",
      "from_asset",
      "to_asset",
      "from_amount_wei",
      "from_address",
      "to_address"
    ],
    "title": "SwapPrepareInput",
    "type": "object"
  },
  "tx_execute": {
    "description": "Simulate/policy/sign/broadcast for a typed prepare envelope.",
    "properties": {
      "envelope": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Required. The exact `envelope` object from a successful `tx_prepare_*` or `tx_prepare_lifi_swap` call: `prepare_output['result']['envelope']`. You cannot call this tool with only `idempotency_key`.",
        "title": "Envelope"
      },
      "idempotency_key": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Optional idempotency key for broadcast (never pass without `envelope`).",
        "title": "Idempotency Key"
      },
      "prepared_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Preferred for LiFi swaps: short server-side prepared transaction id returned by `swap_prepare` or `tx_prepare_lifi_swap`. Avoids sending large calldata through the model.",
        "title": "Prepared Id"
      }
    },
    "title": "TxExecuteToolArgs",
    "type": "object"
  },
  "tx_prepare_erc20_approval": {
    "description": "Public args for ERC-20 approval preparation; tool name supplies the kind.",
    "properties": {
      "amount_wei": {
        "description": "Token amount in the contract's smallest units (not necessarily 1e18). Lookup token decimals: USDC on Base/Ethereum uses **6** \u2014 e.g. 0.01 USDC = **10_000**, 1 USDC = **1_000_000**. WETH uses 18. Do not scale USDC by 10**18.",
        "minimum": 0,
        "title": "Amount Wei",
        "type": "integer"
      },
      "chain": {
        "minLength": 1,
        "title": "Chain",
        "type": "string"
      },
      "from_address": {
        "minLength": 1,
        "title": "From Address",
        "type": "string"
      },
      "spender_address": {
        "minLength": 1,
        "title": "Spender Address",
        "type": "string"
      },
      "token_address": {
        "minLength": 1,
        "title": "Token Address",
        "type": "string"
      }
    },
    "required": [
      "chain",
      "from_address",
      "token_address",
      "spender_address",
      "amount_wei"
    ],
    "title": "TxPrepareErc20ApprovalArgs",
    "type": "object"
  },
  "tx_prepare_erc20_transfer": {
    "description": "Public args for ERC-20 transfer preparation; tool name supplies the kind.",
    "properties": {
      "amount_wei": {
        "description": "Token amount in the contract's smallest units (not necessarily 1e18). Lookup token decimals: USDC on Base/Ethereum uses **6** \u2014 e.g. 0.01 USDC = **10_000**, 1 USDC = **1_000_000**. WETH uses 18. Do not scale USDC by 10**18.",
        "minimum": 0,
        "title": "Amount Wei",
        "type": "integer"
      },
      "chain": {
        "minLength": 1,
        "title": "Chain",
        "type": "string"
      },
      "from_address": {
        "minLength": 1,
        "title": "From Address",
        "type": "string"
      },
      "to_address": {
        "minLength": 1,
        "title": "To Address",
        "type": "string"
      },
      "token_address": {
        "minLength": 1,
        "title": "Token Address",
        "type": "string"
      }
    },
    "required": [
      "chain",
      "from_address",
      "token_address",
      "to_address",
      "amount_wei"
    ],
    "title": "TxPrepareErc20TransferArgs",
    "type": "object"
  },
  "tx_prepare_lifi_swap": {
    "description": "Build from ``swap_prepare`` output: nested ``prepared`` or flat ``route_id`` + tx request.",
    "properties": {
      "chain": {
        "minLength": 1,
        "title": "Chain",
        "type": "string"
      },
      "from_address": {
        "minLength": 1,
        "title": "From Address",
        "type": "string"
      },
      "prepared": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Preferred: exact `prepared` from `swap_prepare` (`route_id` + `transaction_request`).",
        "title": "Prepared"
      },
      "prepared_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Server-side prepared id returned by swap_prepare; preferred because it avoids sending large LiFi calldata through the model.",
        "title": "Prepared Id"
      },
      "route_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Alternative when `prepared` is awkward for the caller: LiFi step id string.",
        "title": "Route Id"
      },
      "transaction_request": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "LiFi transactionRequest dict; pair with `route_id` if no `prepared`.",
        "title": "Transaction Request"
      }
    },
    "required": [
      "chain",
      "from_address"
    ],
    "title": "TxPrepareLiFiInput",
    "type": "object"
  },
  "tx_prepare_native_transfer": {
    "description": "Public args for native transfer preparation; tool name supplies the kind.",
    "properties": {
      "chain": {
        "minLength": 1,
        "title": "Chain",
        "type": "string"
      },
      "from_address": {
        "minLength": 1,
        "title": "From Address",
        "type": "string"
      },
      "to_address": {
        "minLength": 1,
        "title": "To Address",
        "type": "string"
      },
      "value_wei": {
        "minimum": 0,
        "title": "Value Wei",
        "type": "integer"
      }
    },
    "required": [
      "chain",
      "from_address",
      "to_address",
      "value_wei"
    ],
    "title": "TxPrepareNativeArgs",
    "type": "object"
  }
}
